<h1>
  <%= Spree.t('export_mailer.greeting', user_name: @export.user&.first_name) %>
</h1>
<p>
  <%= Spree.t('export_mailer.export_done.message') %>
</p>
<% if spree.respond_to?(:admin_export_url) %>
  <%
    # FIX: the gem's default uses @current_store.formatted_url (the
    # storefront's domain, e.g. "nozfragrances.com") as the host for this
    # admin-only link. But /admin/... only exists on the Rails backend
    # (server.nozfragrances.com), not the Next.js storefront. Using the
    # wrong domain sent this link through the storefront's own locale
    # middleware, which rewrote the path to something like
    # "/in/en/admin/exports/..." and 404'd. Use the backend's own host
    # instead, same as the existing password-reset subscriber already does.
    backend_host = ENV.fetch('APP_HOST', 'server.nozfragrances.com')
  %>
  <p>
    <%= link_to @export.attachment.filename, spree.admin_export_url(@export, host: backend_host, protocol: 'https') %>
  </p>
<% end %>
<p>
  <%= Spree.t('export_mailer.thanks') %><br />
  <%= "#{current_store.name}" %>
</p>
