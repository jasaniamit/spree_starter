module Spree::ExportMailerDecorator
  # Spree dynamically sets ActionMailer::Base.default_url_options[:host] to
  # current_store.url before sending mail (so storefront links work in
  # customer-facing emails). In a headless setup the backend admin lives on
  # a different host than the storefront, so admin-only emails like this one
  # need their own fixed host instead of inheriting the store's URL.
  def default_url_options
    { host: "server.nozfragrances.com", protocol: "https" }
  end
end

Spree::ExportMailer.prepend Spree::ExportMailerDecorator
