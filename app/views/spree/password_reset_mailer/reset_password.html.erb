<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Reset your password – NOZ Fragrances</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style type="text/css">
    /* BASE */
    *, *:before, *:after { box-sizing: border-box; }

    body {
      width: 100% !important;
      height: 100%;
      margin: 0;
      -webkit-text-size-adjust: none;
      background-color: #f2ede8;
      font-family: 'Inter', Arial, sans-serif;
    }

    a { color: #9a7d55; }
    a:hover { color: #7a5e38; }

    img {
      max-width: 100%;
      border: none;
      -ms-interpolation-mode: bicubic;
      vertical-align: middle;
    }

    /* LAYOUT */
    .email-wrapper {
      width: 100%;
      margin: 0;
      padding: 0;
      background-color: #f2ede8;
    }

    .email-content {
      width: 100%;
      margin: 0;
      padding: 0;
    }

    /* LOGO */
    .email-masthead {
      padding: 28px 0;
      text-align: center;
    }

    .email-masthead_logo {
      width: 100%;
      max-width: 200px;
    }

    /* BODY */
    .email-body {
      width: 100%;
      margin: 0;
      padding: 0;
      background-color: #f2ede8;
    }

    .email-body_inner {
      width: 570px;
      margin: 0 auto;
      padding: 0;
    }

    .email-footer {
      width: 570px;
      margin: 0 auto;
      padding: 0;
      text-align: center;
    }

    .email-footer p {
      color: #a09080;
      font-size: 13px;
      line-height: 1.6;
    }

    .email-footer a {
      color: #9a7d55;
      text-decoration: none;
    }

    /* CONTENT CARD */
    .content-cell {
      padding: 40px;
      background-color: #ffffff;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    /* TYPOGRAPHY */
    h1 {
      margin-top: 0;
      margin-bottom: 0;
      color: #1a1a1a;
      font-size: 22px;
      font-weight: 600;
      line-height: 1.35;
      font-family: 'Inter', Arial, sans-serif;
      letter-spacing: -0.3px;
    }

    p {
      margin-top: 0;
      color: #4a4a4a;
      font-size: 15px;
      line-height: 1.7;
      font-family: 'Inter', Arial, sans-serif;
    }

    p.sub {
      font-size: 13px;
      color: #888888;
    }

    p.center {
      text-align: center;
    }

    /* DIVIDER */
    .hr { width: 100%; margin: 0; background-color: #ede8e0; border: none; height: 1px; }

    /* BUTTON */
    .body-action {
      width: 100%;
      margin: 32px auto;
      padding: 0;
      text-align: center;
    }

    .button {
      display: inline-block;
      background-color: #1a1a1a;
      border-radius: 6px;
      color: #ffffff;
      font-family: 'Inter', Arial, sans-serif;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.5;
      text-align: center;
      text-decoration: none;
      padding: 14px 36px;
      letter-spacing: 0.2px;
      -webkit-text-size-adjust: none;
      mso-hide: all;
    }

    /* ATTRIBUTES panel */
    .attributes {
      margin: 0 0 20px;
    }

    .attributes_content {
      background-color: #faf8f5;
      border: 1px solid #ede8e0;
      border-radius: 6px;
      padding: 16px 20px;
    }

    .attributes_item {
      padding: 0;
      color: #4a4a4a;
      font-size: 13px;
      line-height: 1.6;
    }

    /* FALLBACK link box */
    .body-sub {
      margin-top: 24px;
      background-color: #faf8f5;
      border: 1px solid #ede8e0;
      border-radius: 6px;
      padding: 16px 20px;
      word-break: break-all;
    }

    /* GOLD accent bar at top of card */
    .gold-bar {
      height: 3px;
      background: linear-gradient(to right, #b8956a, #d4af7a, #b8956a);
      border-radius: 8px 8px 0 0;
    }

    /* RESPONSIVE */
    @media only screen and (max-width: 600px) {
      .email-body_inner,
      .email-footer {
        width: 100% !important;
      }
      .content-cell {
        padding: 28px 24px !important;
        border-radius: 0 !important;
      }
      .email-masthead { padding: 24px 0 !important; }
    }
  </style>
</head>
<body>

<span class="preheader" style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
  Reset your NOZ Fragrances password — this link expires in 15 minutes.
</span>

<table class="email-wrapper" width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td align="center">
      <table class="email-content" width="100%" cellpadding="0" cellspacing="0" role="presentation">

        <!-- LOGO -->
        <tr>
          <td class="email-masthead">
            <a href="https://www.nozfragrances.com/in/en" target="_blank">
              <img
                class="email-masthead_logo"
                src="https://www.nozfragrances.com/noz.svg"
                alt="NOZ Fragrances"
                width="160"
                height="auto"
              />
            </a>
          </td>
        </tr>

        <!-- EMAIL BODY -->
        <tr>
          <td class="email-body" width="570" cellpadding="0" cellspacing="0">
            <table class="email-body_inner" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td>
                  <!-- Gold accent bar -->
                  <div class="gold-bar"></div>

                  <div class="content-cell">

                    <!-- Heading -->
                    <h1>Reset your password</h1>
                    <hr class="hr" style="margin: 20px 0;" />

                    <!-- Greeting & body -->
                    <p>Hi <strong><%= @user.email %></strong>,</p>
                    <p>
                      You recently requested to reset your password for your
                      <strong>NOZ Fragrances</strong> account.
                      Use the button below to reset it.
                      <strong>This link is only valid for the next 15 minutes.</strong>
                    </p>

                    <!-- CTA Button -->
                    <table class="body-action" align="center" width="100%" cellpadding="0" cellspacing="0" role="presentation">
                      <tr>
                        <td align="center">
                          <table width="100%" border="0" cellspacing="0" cellpadding="0" role="presentation">
                            <tr>
                              <td align="center">
                                <a href="<%= @reset_url %>" class="button" target="_blank">Reset your password</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>

                    <!-- Security note -->
                    <p>
                      If you did not request a password reset, please ignore this email or
                      <a href="https://www.nozfragrances.com/in/en/contact-us">contact our support team</a>
                      if you have questions.
                    </p>

                    <p>Thanks,<br />The NOZ Fragrances Team</p>

                    <hr class="hr" style="margin: 24px 0;" />

                    <!-- Fallback URL -->
                    <div class="body-sub">
                      <p class="sub" style="margin:0 0 6px 0;font-weight:600;text-transform:uppercase;letter-spacing:0.6px;">
                        Having trouble with the button?
                      </p>
                      <p class="sub" style="margin:0;">
                        Copy and paste this URL into your browser:<br />
                        <a href="<%= @reset_url %>" style="color:#9a7d55;word-break:break-all;font-size:12px;font-family:'Courier New',monospace;">
                          <%= @reset_url %>
                        </a>
                      </p>
                    </div>

                  </div><!-- /content-cell -->
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- FOOTER -->
        <tr>
          <td>
            <table class="email-footer" align="center" width="570" cellpadding="0" cellspacing="0" role="presentation">
              <tr>
                <td align="center" style="padding: 28px 0 40px;">
                  <p style="margin:0 0 8px;">
                    <a href="https://www.nozfragrances.com/in/en">Visit Store</a>
                    &nbsp;&middot;&nbsp;
                    <a href="https://www.nozfragrances.com/in/en/contact-us">Support</a>
                    &nbsp;&middot;&nbsp;
                    <a href="https://www.nozfragrances.com/in/en/privacy-policy">Privacy Policy</a>
                  </p>
                  <p style="margin:0 0 4px;">&copy; <%= Time.current.year %> NOZ Fragrances. All rights reserved.</p>
                  <p style="margin:0;">This email was sent to <%= @user.email %></p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</body>
</html>
